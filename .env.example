# LOCAL ONLY — read by `docker compose` on your machine, never by the pipeline.
# In production these come from Octopus variables, injected as -e flags at
# `docker run` time. The two paths are independent.
#
# Copy to .env and fill in. NEVER commit .env.

# Neon POOLED endpoint (host contains "-pooler"), Npgsql key/value format.
# NOT a postgresql:// URL — pasting one puts the database name onto the host and
# DNS resolution fails with "Name or service not known".
EMT_DB_CONNECTION=Host=ep-xxxx-pooler.REGION.aws.neon.tech;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Connection Idle Lifetime=60;Connection Pruning Interval=10

# MUST match the identity service exactly — this service validates tokens that
# service mints. A mismatch means login succeeds and every call here 401s.
EMT_JWT_KEY=
EMT_JWT_ISSUER=https://auth.employee-management-tool.com
EMT_JWT_AUDIENCE=emt-api

EMT_CORS_ORIGIN_APP=https://app.employee-management-tool.com
EMT_CORS_ORIGIN_SYS=https://sys.employee-management-tool.com
