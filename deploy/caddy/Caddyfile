# Caddy fronts both EMT backends on the droplet. It runs as a pod in the k3s
# cluster (namespace emt) and is the only thing bound to host ports; the APIs are
# reachable only through their k3s Services, by name (emt-identity, emt-api).
#
# Certificates are issued and renewed automatically via Let's Encrypt. That
# requires each hostname below to already resolve to this droplet — Caddy asks
# for a cert the moment it starts, and failed validations count against Let's
# Encrypt's rate limit (5 per hostname per hour).

{
	email jason.ampah.dev@gmail.com
}

# Identity service — auth, tokens, account management.
auth.employee-management-tool.com {
	reverse_proxy emt-identity:8080
	encode zstd gzip
}

# Org-domain microservice.
api.employee-management-tool.com {
	reverse_proxy emt-api:8080
	encode zstd gzip
}
